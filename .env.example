# PostgreSQL connection string. Keep real credentials in your local .env.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Required for AI and web search features
GOOGLE_API_KEY=replace_with_google_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=replace_with_tavily_api_key

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TuongGPT-v2
